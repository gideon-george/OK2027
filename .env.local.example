# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase -----------------------------------------------------------
# Until these are set the site still builds and serves normally: every
# database-backed feature shows an honest "not live yet" state rather than a
# form that silently discards what people type.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Used by the seed scripts. Never shipped to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ----------------------------------------------------------------
# Base path the site is served under. Set to an empty string when moving to a
# custom domain such as https://nokm.ng
NEXT_PUBLIC_BASE_PATH=/OK2027

# Full public URL. Used for the sitemap, canonical URLs and link previews.
NEXT_PUBLIC_APP_URL=https://gideon-george.github.io/OK2027

# --- Optional -----------------------------------------------------------
# Only needed if map views are added later. No current page uses it.
NEXT_PUBLIC_MAPBOX_TOKEN=
